# --- ロリポップ！AI ゲートウェイ経由（キー 1 本で jev と claude の両方） ---
# 推論用 API キー。console/v1 で発行して confirm まで通したもの。
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://ai-gateway.lolipop.jp
TYPESAFE_DEFAULT_MODEL=typesafe/jev-latest

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://ai-gateway.lolipop.jp
JEV_LLM_MODEL=claude-haiku-4-5

# キー発行に使うマネジメントトークン（推論には使えない）
LOLIPOP_GATEWAY_MGMT_TOKEN=
LOLIPOP_ACCOUNT_ID=

# --- 各社に直接つなぐ場合はベース URL を消す ---
# TYPESAFE_API_KEY=...            # https://typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# ANTHROPIC_API_KEY=...           # https://console.anthropic.com
# JEV_LLM_MODEL=claude-haiku-4-5

# コスト計算に使う Jev の単価（USD / 1M tokens）
# JEV_INPUT_PRICE=0.10
# JEV_OUTPUT_PRICE=0.40
